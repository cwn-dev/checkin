@using checkin.Pages.Dtos

@model List<ListPageDto>

<div id="list" class="list-modal opening"
     _="on closeSidebar add .closing then remove .opening then wait for animationend then remove me">
     <h1 class="title">Checkins</h1>
    <table border="1" cellpadding="8" cellspacing="0">
        <thead>
            <tr>
                <th>Note</th>
                <th>Latitude</th>
                <th>Longitude</th>
                <th>Timestamp</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var checkin in Model)
            {
                <tr>
                    <td>@checkin.Note</td>
                    <td>@checkin.Latitude</td>
                    <td>@checkin.Longitude</td>
                    <td>@checkin.DateTime</td>
                </tr>
            }
        </tbody>
    </table>
</div>