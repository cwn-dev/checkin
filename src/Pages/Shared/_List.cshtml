@using checkin.Pages.Dtos

@model List<ListPageDto>

<div id="list" class="list-modal opening"
     _="on closeSidebar add .closing then remove .opening then wait for animationend then remove me">
    <div class="modal-title"> <h2>Checkins</h2></div>

    @foreach (var checkin in Model)
    {
        <article class="journal-entry" data-latitude="@checkin.Latitude" data-longitude="@checkin.Longitude">
            <div class="entry-header">
                <time>
                    @checkin.DateTime
                </time>
            </div>
            <div class="entry-note">
                @checkin.Note
            </div>
            <div class="entry-meta">
                <div>
                    <label>Latitude</label>
                    <span>@checkin.Latitude</span>
                </div>
                <div>
                    <label>Longitude</label>
                    <span>@checkin.Longitude</span>
                </div>
            </div>
        </article>
    }
</div>


