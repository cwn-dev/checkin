@using checkin.Pages.Dtos

@model List<ListPageDto>

<div id="list" class="list-modal opening">
    @foreach (var checkin in Model)
    {
        <article class="journal-entry"
                 data-latitude="@checkin.Latitude"
                 data-longitude="@checkin.Longitude">
            <div class="entry-header">
                <time>
                    @($"{checkin.DateTime} ({checkin.Id})")
                </time>
            </div>
            <div class="entry-note">
                @checkin.Note
            </div>
            <div class="entry-meta">
                <div>
                    <label>Latitude</label>
                    <span>@checkin.Latitude</span>
                </div>
                <div>
                    <label>Longitude</label>
                    <span>@checkin.Longitude</span>
                </div>
            </div>
        </article>
    }
</div>


