@page

<div id="list">
    <table border="1" cellpadding="8" cellspacing="0">
        <thead>
            <tr>
                <th>Note</th>
                <th>Latitude</th>
                <th>Longitude</th>
                <th>Timestamp</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>{result.Note}</td>
                <td>{result.Lat}</td>
                <td>{result.Long}</td>
                <td>{result.DateTime}</td>
            </tr>
        </tbody>
    </table>
</div>