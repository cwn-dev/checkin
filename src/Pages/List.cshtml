@page
@model checkin.Pages.ListModel

<div id="list">
    <table border="1" cellpadding="8" cellspacing="0">
        <thead>
            <tr>
                <th>Note</th>
                <th>Latitude</th>
                <th>Longitude</th>
                <th>Timestamp</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var checkin in Model.Checkins)
            {
                <tr>
                    <td>@checkin.Note</td>
                    <td>@checkin.Latitude</td>
                    <td>@checkin.Longitude</td>
                    <td>@checkin.DateTime</td>
                </tr>
            }
        </tbody>
    </table>
</div>